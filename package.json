{
  "name": "kitty",
  "productName": "Kitty",
  "version": "0.1.12",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "dist": "vite build && electron-builder --win nsis --publish never",
    "release": "vite build && electron-builder --win nsis --publish always",
    "dist:linux": "vite build && electron-builder --linux AppImage --publish never",
    "release:linux": "vite build && electron-builder --linux AppImage --publish always"
  },
  "dependencies": {
    "@fontsource/cascadia-mono": "^5.3.0",
    "electron-updater": "^6.8.11",
    "framer-motion": "^14.8.0",
    "lucide-react": "^1.65.0",
    "mammoth": "^1.13.0",
    "node-ical": "^0.27.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "author": "Kitty",
  "description": "A dynamic island for Windows, with a cat.",
  "build": {
    "appId": "com.kitty.island",
    "productName": "Kitty",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/tray.ico",
      "assets/tray.png",
      "bt.ps1",
      "claude.js",
      "dist/**/*",
      "info.js",
      "main.js",
      "media-linux.js",
      "media.ps1",
      "package.json",
      "preload.js",
      "settings.js",
      "updater.js",
      "usage.js",
      "wifi.js",
      "convert.js",
      "convert.ps1",
      "phone.js",
      "downloader.js"
    ],
    "asarUnpack": [
      "bt.ps1",
      "media.ps1",
      "convert.ps1",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kitty",
      "uninstallDisplayName": "Kitty",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "VidwathN-Karanth",
        "repo": "Kitty"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "${productName}-${version}.${ext}",
      "synopsis": "A dynamic island with a cat",
      "description": "Kitty: a dynamic island for your desktop, with a cat that keeps you company."
    }
  }
}
