{
  "name": "kitty",
  "productName": "Kitty",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "dist": "vite build && electron-builder --win nsis --publish never",
    "release": "vite build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "framer-motion": "^14.8.0",
    "lucide-react": "^1.65.0",
    "node-ical": "^0.27.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "author": "Kitty",
  "description": "A dynamic island for Windows, with a cat.",
  "build": {
    "appId": "com.kitty.island",
    "productName": "Kitty",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/tray.ico",
      "assets/tray.png",
      "bt.ps1",
      "claude.js",
      "dist/**/*",
      "info.js",
      "main.js",
      "media.ps1",
      "package.json",
      "preload.js",
      "settings.js",
      "updater.js",
      "usage.js"
    ],
    "asarUnpack": [
      "bt.ps1",
      "media.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "VidwathN-Karanth",
        "repo": "Kitty"
      }
    ]
  }
}
